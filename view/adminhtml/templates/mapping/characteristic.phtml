<?php /** @var \Zitec\EmagMarketplace\Block\Adminhtml\Mapping\Edit\Characteristic\Form $block */ ?>
<?php /** @var \Magento\Framework\Escaper $escaper */ ?>
<style>
    .emkp-admin__field {
        padding-top: 25px;
        clear: both;
    }

    .emkp-admin__field-label {
        width: calc((100%) * 0.25 - 53px);
        float: left;
        margin-left: 30px;
    }

    .emkp-admin__field-control {
        width: calc((100%) * 0.5 - 30px);
        float: left;
        margin-left: 30px;
    }

    .display-values-link {
        margin-top: 1rem;
    }

    .emkp-admin__field-control select,
    .emkp-admin__field-control .js-emkp-mapping-error {
        width: 350px;
    }

    .js-emkp-mapping-error {
        display: none;
    }
</style>
<div id="emkp_characterisics_div">
    <?php foreach ($block->getCharacteristics() as $characteristic) { ?>
        <?php
        $labelId = 'characteristic_label_' . $characteristic->getId();
        $isMandatory = $characteristic->isMandatory();
        ?>
        <!-- div -->
        <div class="admin__field <?php if ($isMandatory) { ?> _required<?php } ?> emkp-admin__field">
            <label class="admin__field-label emkp-admin__field-label" for="<?= $escaper->escapeHtmlAttr($labelId) ?>">
                <span><?= $escaper->escapeHtml($characteristic->getName()) ?></span>
            </label>

            <!-- div -->
            <div class="admin__field-control emkp-admin__field-control">
                <!-- select -->
                <select class="admin__control-select js-emkp-mapping-input"
                        name="characteristic[<?= $escaper->escapeHtmlAttr($characteristic->getId()) ?>]" id="<?= $escaper->escapeHtmlAttr($labelId) ?>"
                        aria-describedby="notice-<?= $escaper->escapeHtmlAttr($labelId) ?>" <?php if ($isMandatory) { ?> required<?php } ?>>
                    <option data-title="<?= $escaper->escapeHtmlAttr(__('Select attribute')) ?>" value="0" selected disabled>
                        <?= $escaper->escapeHtml(__('Select attribute')) ?>
                    </option>

                    <!-- option -->
                    <?php foreach ($this->getMagentoAttributes() as $attribute) { ?>
                        <option data-title="<?= $escaper->escapeHtmlAttr($attribute->getDefaultFrontendLabel()) ?>"
                                value="<?= $escaper->escapeHtmlAttr($attribute->getId()) ?>"
                            <?php if ($this->isAttributeSelected($characteristic->getId(),
                                $attribute->getId())) : ?> selected<?php endif ?>
                        >
                            <?= $escaper->escapeHtml($attribute->getDefaultFrontendLabel()) ?>
                        </option>
                    <?php } ?>
                </select>

                <!-- label -->
                <label class="admin__field-error js-emkp-mapping-error">
                    <?= $escaper->escapeHtml(__('This is a required field.')) ?>
                </label>

                <?php if (!empty($characteristic->getValues())): ?>
                    <div class="admin__field">
                        <div class="admin__field-control">
                            <button type="button"
                                    data-values-url='<?= $escaper->escapeHtmlAttr($block->getValuesUrl()) ?>'
                                    data-characteristic-id='<?= $escaper->escapeHtmlAttr($characteristic->getId()) ?>'
                                    class="action-additional display-values-link js-emkp-show-allowed-values"
                            >
                                <span data-bind="text: title">
                                    <?php if (!$characteristic->getAllowNewValue()): ?>
                                        <?= $escaper->escapeHtml(__('This characteristic does not allow new values.')) ?>
                                    <?php endif ?>
                                    <?= $escaper->escapeHtml(__('Click here to show values.')) ?>
                                </span>
                            </button>
                        </div>
                    </div>
                <?php endif; ?>
            </div>

        </div>
    <?php } ?>
</div>

<?php
/** @var \Magento\Framework\Escaper $escaper */
$currentOrderId = $this->getCurrentOrderId();
$invoices = $this->getUploadedInvoicesByOrderId($currentOrderId);
?>
<section class="admin__page-section order-view-invoice-upload-form">
    <div class="admin__field _required emkp-admin__field" data-index="emag_category_id">
        <form action="<?= $escaper->escapeUrl($this->getAjaxUploadInvoiceUrl()) ?>" enctype="multipart/form-data" method="POST">
            <input type='hidden' name="order_id" value="<?= (int)$currentOrderId ?>"/>
            <input name="form_key" type="hidden" value="<?= $escaper->escapeHtmlAttr($this->getFormKey()) ?>"/>
            <div class="admin__page-section-item-title">
                <span class="title"><?= $escaper->escapeHtml(__('Upload Invoice')) ?></span>
            </div>
            <div class="admin__field-control emkp-admin__field-control">
                <input type='file' accept="application/pdf,.pdf" class="admin__control-file js-emkp-invoice-file-input" name="file"/>
            </div>
            <div class="admin__field-control emkp-admin__field-control">
                <button class="action primary" type="submit" title="<?= $escaper->escapeHtmlAttr(__('Upload Invoice')) ?>">
                    <span><?= $escaper->escapeHtml(__('Upload Invoice')) ?></span>
                </button>
            </div>
        </form>
    </div>
</section>
<?php if ($invoices) : ?>
<section class="admin__page-section order-view-invoice-list">
    <div class="admin__page-section-item order-account-information">
        <div class="admin__page-section-item-title">
            <span class="title"><?= $escaper->escapeHtml(__('Uploaded Invoices')) ?></span>
            <div class="actions">
            </div>
        </div>
        <div class="admin__page-section-item-content">
            <table class="admin__table-secondary order-account-information-table">
                <tbody>
                <?php foreach ($invoices as $invoice) : ?>
                    <?php $pathArray = explode('/', (string)$invoice->getPath()); ?>
                    <tr>
                        <th>
                            <a target="_blank" rel="noopener noreferrer" href="<?= $escaper->escapeUrl($invoice->getUrl()) ?>">
                                <?= $escaper->escapeHtml(end($pathArray)) ?>
                            </a>
                        </th>
                        <td>
                            <?= $escaper->escapeHtml(__('Upload date:') . ' ' . $invoice->getCreatedAt()) ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    </div>
</section>
